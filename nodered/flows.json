  {
    "id": "fn_log_event",
    "type": "function",
    "z": "cc25d96a5ae42c89",
    "name": "Activity log builder",
    "func": "let row = { Time: new Date().toLocaleTimeString(), Event: '?', Detail: '' };\nlet t = String(msg.topic || '');\nlet slot = (t.match(/slot(\\d)/)||[])[1];\nlet st = String(msg.payload||'').trim().toLowerCase();\nif (t.includes('/state') && slot) {\n    row.Event = 'S' + slot + ' ' + ({free:'AVAILABLE', reserved:'RESERVED', occupied:'IN USE'}[st] || st.toUpperCase());\n    row.Detail = st;\n} else if (t.includes('/status')) {\n    row.Event = 'ESP ' + (st==='online' ? 'ONLINE' : 'OFFLINE');\n    row.Detail = st;\n} else if (t.includes('/nfc/tap')) {\n    let p; try { p = JSON.parse(msg.payload); } catch(e) { p = null; }\n    row.Event = 'RFID tap';\n    row.Detail = 'UID ' + ((p && p.uid) || String(msg.payload).slice(0,8));\n} else if (t.includes('/alerts')) {\n    let p; try { p = JSON.parse(msg.payload); } catch(e) { p = null; }\n    row.Event = 'ALERT' + (p && p.slot ? ' S'+p.slot : '');\n    row.Detail = (p && p.type) || String(msg.payload);\n} else {\n    row.Event = t.split('/').pop();\n    row.Detail = String(msg.payload).slice(0, 40);\n}\nlet log = flow.get('activityLog') || [];\nlog.unshift(row);\nif (log.length > 15) log = log.slice(0, 15);\nflow.set('activityLog', log);\nmsg.payload = log;\nreturn msg;",
    "x": 560,
    "y": 540,
    "wires": [
      [
        "e62574251e991fff"
      ]
    ]
  }
