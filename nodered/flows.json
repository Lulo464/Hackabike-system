    "type": "function",
    "z": "cc25d96a5ae42c89",
    "name": "LED strip state",
    "func": "// bikeslot-test/light/strip/state JSON -> \"ON \u00b7 77 \u00b7 rgb(255,255,255) \u00b7 Slots\"\nlet p; try { p = JSON.parse(msg.payload); } catch (e) { return msg; }\nlet c = p.color || {};\nlet eff = p.effect || '-';\nmsg.payload = (p.state === 'ON' ? 'ON' : 'OFF') +\n    ' \u00b7 ' + (p.brightness !== undefined ? p.brightness : '-') +\n    ' \u00b7 rgb(' + (c.r !== undefined ? c.r : 0) + ',' + (c.g !== undefined ? c.g : 0) + ',' + (c.b !== undefined ? c.b : 0) + ')' +\n    ' \u00b7 ' + eff;\nreturn msg;",
