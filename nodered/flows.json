    {
        "id": "fn_cpu",
        "type": "function",
        "z": "cc25d96a5ae42c89",
        "name": "cpu pct",
        "func": "var s = String(msg.payload||'').trim().split(/\\s+/);\nvar idle = parseInt(s[4]||'0',10);\nvar total = 0;\nfor (var i=1;i<s.length;i++){ var v=parseInt(s[i]||'0',10); if(!isNaN(v)) total+=v; }\nif (isNaN(idle) || total<=0) return null;\nvar last = context.get('last') || null;\ncontext.set('last',{t:total,idle:idle});\nif (!last) return null;\nvar dt = total - last.t, di = idle - last.idle;\nif (dt<=0 || di<0 || di>dt) return null;\nvar cpuPct = Math.round((1-(di/dt))*1000)/10;\nif (cpuPct<0) cpuPct=0; if (cpuPct>100) cpuPct=100;\nreturn {payload: cpuPct};",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
