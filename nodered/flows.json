            ]
        ]
    },
    {
        "id": "fn_esp_seen",
        "type": "function",
        "z": "cc25d96a5ae42c89",
        "name": "esp last seen",
        "func": "// Proof-of-life tap on the raw distance feed. Records the arrival\n// time per ESP32, then passes the message on untouched.\n// ESP32-1 drives slot1/slot2, ESP32-2 drives slot3/slot4.\nconst owner = { slot1: 'esp1', slot2: 'esp1',\n                slot3: 'esp2', slot4: 'esp2' };\nconst slot = String(msg.topic || '').split('/')[1];\nconst seen = flow.get('espSeen') || {};\nif (owner[slot]) {\n    seen[owner[slot]] = Date.now();\n    flow.set('espSeen', seen);\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 200,
        "wires": [
