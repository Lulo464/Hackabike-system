  {
    "id": "fn_cpu_pct",
    "type": "function",
    "z": "cc25d96a5ae42c89",
    "name": "CPU % delta",
    "func": "let m = String(msg.payload).trim().split(/\\s+/);\nlet total = 0, idle = 0;\nfor (let i=2;i<m.length;i++){\n    if (i<=5 || i===8) idle += parseInt(m[i])||0;\n    total += parseInt(m[i])||0;\n}\nlet prev = flow.get('cpuPrev');\nflow.set('cpuPrev', {total, idle});\nif (!prev || total <= prev.total) return null;\nlet dT = total - prev.total;\nlet busy = 100 * (1 - (idle - prev.idle) / dT);\nmsg.payload = Math.max(0, Math.min(100, Math.round(busy)));\nreturn msg;",
    "x": 560,
    "y": 820,
    "wires": [
      [
        "gauge_cpu"
      ]
    ]
  },
