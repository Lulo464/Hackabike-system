    "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nmsg.payload = (p.type || 'alert').toUpperCase() + (p.slot ? ' - slot ' + p.slot : '') + '   @ ' + (p.timestamp || '-');\nreturn msg;",
