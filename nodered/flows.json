    {
        "id": "comment_smart_logic",
        "type": "comment",
        "z": "cc25d96a5ae42c89",
        "name": "\u2699\ufe0f SMART PARKING LOGIC \u2699\ufe0f",
        "info": "Handles RFID assignments, LCD display, and LED color states.",
        "x": 970,
        "y": 400,
        "wires": []
    },
    {
        "id": "in_rfid_tap",
        "type": "mqtt in",
        "z": "cc25d96a5ae42c89",
        "name": "RFID Tap",
        "topic": "bikestation/entrance/nfc/tap",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 700,
        "y": 580,
        "wires": [
            [
                "fn_smart_logic"
            ]
        ]
    },
    {
        "id": "fn_smart_logic",
        "type": "function",
        "z": "cc25d96a5ae42c89",
        "name": "Assign Slot & Control LEDs",
        "func": "// Input: bikestation/slotN/state OR bikestation/entrance/nfc/tap\n// Output1: LCD (bikestation/entrance/oled/display), Output2: slot state publish\nlet slotState = flow.get('slotState') || {1: false, 2: false, 3: false, 4: false};\nlet reservedSlot = flow.get('reservedSlot') || null;\n\nlet outLCD = null;\nlet outState = null;\n\nif (msg.topic.startsWith('bikestation/slot')) {\n    let slot = msg.topic.split('/')[1].replace('slot', '');\n    let st = String(msg.payload).trim().toLowerCase();\n    let occupied = st === 'occupied';\n    slotState[slot] = occupied;\n    flow.set('slotState', slotState);\n    if (occupied && reservedSlot == slot) {\n        flow.set('reservedSlot', null);\n        outLCD = { topic: 'bikestation/entrance/oled/display', payload: 'Secured in Slot ' + slot + '!' };\n    }\n}\nelse if (msg.topic.includes('tap') || msg.topic.includes('nfc')) {\n    let targetSlot = null;\n    for (let i = 1; i <= 4; i++) {\n        if (!slotState[i]) { targetSlot = i; break; }\n    }\n    if (targetSlot) {\n        flow.set('reservedSlot', targetSlot);\n        outLCD = { topic: 'bikestation/entrance/oled/display', payload: 'Park at Slot ' + targetSlot };\n        outState = { topic: 'bikestation/slot' + targetSlot + '/state', payload: 'reserved', retain: true };\n    } else {\n        outLCD = { topic: 'bikestation/entrance/oled/display', payload: 'Station Full!' };\n    }\n}\n\nreturn [outLCD, outState];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 560,
        "wires": [
            [
                "out_lcd_screen"
            ],
            [
                "out_slot_state"
            ]
        ]
    },
