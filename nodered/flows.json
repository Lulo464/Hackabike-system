  {
    "id": "in0001",
    "type": "mqtt in",
    "z": "tab_bikestation",
    "name": "system/status",
    "topic": "bikestation/system/status",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 60,
    "wires": [
      [
        "fn0002"
      ]
    ]
  },
  {
    "id": "fn0002",
    "type": "function",
    "z": "tab_bikestation",
    "name": "parse status",
    "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nmsg.payload = (p.status || '?') + '   |   last seen ' + (p.timestamp || '-');\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
