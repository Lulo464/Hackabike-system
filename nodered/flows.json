    "format": "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n\n.v-main {\n  background-image: url('https://images.hdqwalls.com/wallpapers/landscape-alpine-mountains-landscape-5k-1k.jpg');\n  background-size: cover;\n  background-repeat: no-repeat;\n  background-attachment: fixed;\n}\n\n.v-main::before {\n  content: '';\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.08);\n  pointer-events: none;\n  z-index: 0;\n}\n\nbody {\n  font-family: 'Inter', sans-serif !important;\n}\n\n.nrdb-ui-group .v-card {\n  background: rgba(255, 255, 255, 0.1) !important;\n  backdrop-filter: blur(40px) saturate(180%) !important;\n  -webkit-backdrop-filter: blur(40px) saturate(180%) !important;\n  border: 0.5px solid rgba(255, 255, 255, 0.3) !important;\n  border-top: 0.5px solid rgba(255, 255, 255, 0.5) !important;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), inset 0 0.5px 0 rgba(255, 255, 255, 0.6) !important;\n  border-radius: 16px !important;\n}\n\n.room-blaue-box .v-card { border-left: 4px solid #0094CE !important; }\n.room-gruene-box .v-card { border-left: 4px solid #3a9e3a !important; }\n\n.last-update-bar {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n  padding: 4px 8px;\n  font-size: 13px;\n}\n.lu-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n.lu-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  display: inline-block;\n}\n.lu-name {\n  color: rgba(255,255,255,0.7);\n  font-weight: 500;\n}\n.lu-time {\n  color: #fff;\n  font-weight: 600;\n}",
