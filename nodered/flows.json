            ]
        ]
    },
    {
        "id": "fn_esp_status",
        "type": "function",
        "z": "cc25d96a5ae42c89",
        "name": "esp status",
        "func": "// A healthy ESP32 publishes roughly twice a second, so 20s without\n// a single message means it is off, booting, or its MQTT client is\n// wedged. Ping is not used: a rebooting board answers ICMP before it\n// reconnects, so it would look healthy while publishing nothing.\nconst LIMIT = 20;\nconst seen = flow.get('espSeen') || {};\nconst now = Date.now();\nconst out = [];\nfor (const d of [\n        { id: 'esp1', label: 'ESP32-1', slots: 'Slots 1-2' },\n        { id: 'esp2', label: 'ESP32-2', slots: 'Slots 3-4' }]) {\n    const t = seen[d.id];\n    const secs = t ? Math.round((now - t) / 1000) : null;\n    const online = secs !== null && secs <= LIMIT;\n    out.push({\n        topic: d.id,\n        payload: {\n            label: d.label,\n            slots: d.slots,\n            online: online,\n            secs: secs,\n            text: online ? 'ONLINE'\n                 : secs === null ? 'NO DATA' : 'OFFLINE ' + secs + 's'\n        }\n    });\n}\nreturn [out];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1480,
        "y": 260,
        "wires": [
            [
                "esp_badge_1"
            ],
            [
                "esp_badge_2"
            ]
        ]
    },
