  {
    "id": "e8f3d13f0af759ae",
    "type": "function",
    "z": "cc25d96a5ae42c89",
    "name": "slot summary",
    "func": "// bikestation/slotN/state -> \"free\"|occupied. Track and count busy slots.\nlet state = flow.get('slotState') || {};\nlet slot = msg.topic.split('/')[1].replace('slot', '');\nstate[slot] = String(msg.payload).trim().toLowerCase() === 'free' ? false : true;\nflow.set('slotState', state);\nlet occupied = Object.values(state).filter(v => v === true).length;\nmsg.payload = occupied + ' Bikes';\nreturn msg;",
    "outputs": 1,
    "x": 550,
    "y": 140,
    "wires": [
      [
        "4accbad6a9851944"
      ]
    ]
  },
