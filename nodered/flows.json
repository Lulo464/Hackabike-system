    {
        "id": "fn_kiosk_avail",
        "type": "function",
        "z": "cc25d96a5ae42c89",
        "name": "kiosk availability",
        "func": "// bikestation/slotN/state -> availability for the user kiosk pane\nlet s = flow.get('slotState') || {};\nlet m = (msg.topic || '').match(/slot(\\d+)/);\nif (m) {\n  s[m[1]] = String(msg.payload).trim().toLowerCase() === 'occupied';\n  flow.set('slotState', s);\n}\nlet free = 0;\nfor (let i = 1; i <= 4; i++) { if (s[i] !== true) free++; }\nreturn { topic: 'kiosk', payload: { free: free, total: 4 } };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
