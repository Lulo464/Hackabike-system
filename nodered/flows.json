  {
    "id": "fn0041",
    "type": "function",
    "z": "tab_bikestation",
    "name": "build LED payload",
    "func": "const seg = (msg.topic || '').split('/');\n// inbound topic: bikestation/set/<slot>/<color|blink>\nconst slot = seg[2];\nconst what = seg[3];\nif (what === 'color') { flow.set('color' + slot, msg.payload); }\nelse { flow.set('blink' + slot, msg.payload === true || msg.payload === 'true'); }\nmsg.topic = 'bikestation/slot/' + slot + '/led';\nmsg.payload = JSON.stringify({\n  slot: Number(slot),\n  color: flow.get('color' + slot) || 'green',\n  blink: flow.get('blink' + slot) || false\n});\nmsg.qos = 0;\nmsg.retain = true;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
