    "z": "cc25d96a5ae42c89",
    "name": "Assign Slot & Control LEDs",
    "func": "// Input: bikestation/slotN/state (\"free\"|...) OR bikestation/entrance/nfc/tap\n// Output1: LCD (bikestation/entrance/oled/display), Output2: LED (native ESPHome light)\nlet slotState = flow.get('slotState') || {1: false, 2: false, 3: false, 4: false};\nlet reservedSlot = flow.get('reservedSlot') || null;\n\nlet outLCD = null;\nlet outLED = null;\n\nif (msg.topic.startsWith('bikestation/slot')) {\n    let slot = msg.topic.split('/')[1].replace('slot', '');\n    let occupied = String(msg.payload).trim().toLowerCase() === 'free' ? false : true;\n\n    slotState[slot] = occupied;\n    flow.set('slotState', slotState);\n\n    if (occupied) {\n        // Bike parked: whole strip RED\n        if (reservedSlot == slot) { flow.set('reservedSlot', null); }\n        outLED = {\n            topic: 'bikeslot-test/light/strip/command',\n            payload: JSON.stringify({ state: 'ON', brightness: 150, color: {r:255, g:0, b:0} })\n        };\n        outLCD = {\n            topic: 'bikestation/entrance/oled/display',\n            payload: `Secured in Slot ${slot}!`\n        };\n    } else {\n        // Bike removed: whole strip GREEN\n        outLED = {\n            topic: 'bikeslot-test/light/strip/command',\n            payload: JSON.stringify({ state: 'ON', brightness: 150, color: {r:0, g:255, b:0} })\n        };\n    }\n}\nelse if (msg.topic.includes('tap') || msg.topic.includes('nfc')) {\n    let targetSlot = null;\n    for (let i = 1; i <= 4; i++) {\n        if (!slotState[i]) { targetSlot = i; break; }\n    }\n    if (targetSlot) {\n        flow.set('reservedSlot', targetSlot);\n        outLCD = {\n            topic: 'bikestation/entrance/oled/display',\n            payload: `Park at Slot ${targetSlot}`\n        };\n        // Reserved: whole strip BLUE\n        outLED = {\n            topic: 'bikeslot-test/light/strip/command',\n            payload: JSON.stringify({ state: 'ON', brightness: 150, color: {r:0, g:0, b:255} })\n        };\n    } else {\n        outLCD = {\n            topic: 'bikestation/entrance/oled/display',\n            payload: 'Station Full!'\n        };\n    }\n}\n\nreturn [outLCD, outLED];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
