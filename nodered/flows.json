  {
    "id": "in_rfid_tap",
    "type": "mqtt in",
    "z": "cc25d96a5ae42c89",
    "name": "RFID Tap",
    "topic": "bikestation/entrance/nfc/tap",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 700,
    "y": 580,
    "wires": [
