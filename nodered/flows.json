    "name": "slot summary",
    "func": "// bikestation/slotN/state -> occupied count. reserved == bike not parked yet.\nlet state = flow.get('slotState') || {};\nlet slot = msg.topic.split('/')[1].replace('slot', '');\nlet st = String(msg.payload).trim().toLowerCase();\nstate[slot] = st === 'occupied';\nflow.set('slotState', state);\nlet occupied = Object.values(state).filter(v => v === true).length;\nmsg.payload = occupied + ' Bikes';\nreturn msg;",
    "outputs": 1,
