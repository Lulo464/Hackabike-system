  {
    "id": "3ce75f146a09776a",
    "type": "function",
    "z": "cc25d96a5ae42c89",
    "name": "NFC history builder",
    "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nvar log = flow.get('nfcLog') || [];\nlog.unshift({\n    Time: p.timestamp || new Date().toLocaleTimeString(),\n    'Tag UID': p.uid || '?',\n    Action: p.action || 'tap'\n});\nif (log.length > 15) log = log.slice(0, 15);\nflow.set('nfcLog', log);\nmsg.payload = log;\nreturn msg;",
    "outputs": 1,
    "x": 350,
    "y": 1200,
    "wires": [
      [
        "e62574251e991fff"
      ]
    ]
  },
