        "order": 1,
        "width": 12,
        "height": 5,
        "format": "<template>\n  <div class=\"kiosk-wrap\" :class=\"`is-${tone}`\">\n    <div class=\"kiosk-hint\">TAP CARD TO ENTER</div>\n    <div class=\"kiosk-count\" v-if=\"free !== null\">{{ free }}</div>\n    <div class=\"kiosk-cap\" v-if=\"free !== null\">of {{ total }} available</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return { free: null, total: 4, tone: 'ok' };\n  },\n  watch: {\n    'msg.payload': function (p) {\n      if (p && typeof p === 'object' && p.free !== undefined) {\n        this.free = p.free;\n        this.total = p.total;\n        this.tone = p.free > 0 ? 'ok' : 'full';\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.kiosk-wrap {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(6px, 1.5vh, 18px);\n  width: 100%;\n  min-height: clamp(220px, 42vh, 420px);\n  text-align: center;\n}\n.kiosk-hint {\n  font-size: clamp(20px, 5vw, 54px);\n  font-weight: 700;\n  letter-spacing: 2px;\n  color: #ffffff;\n  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);\n}\n.kiosk-count {\n  font-size: clamp(80px, 20vw, 210px);\n  font-weight: 800;\n  line-height: 0.95;\n  color: #00e676;\n  text-shadow: 0 6px 40px rgba(0, 0, 0, 0.6);\n}\n.kiosk-wrap.is-full .kiosk-count { color: #ff5252; }\n.kiosk-cap {\n  font-size: clamp(14px, 3vw, 30px);\n  font-weight: 600;\n  color: rgba(255, 255, 255, 0.88);\n  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);\n}\n</style>",
