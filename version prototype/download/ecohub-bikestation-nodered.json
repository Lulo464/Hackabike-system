    {
        "id": "fn_nfc_table",
        "type": "function",
        "z": "tab_bikestation",
        "name": "NFC history builder",
        "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nvar log = flow.get('nfcLog') || [];\nlog.unshift({\n    Time: p.timestamp || new Date().toLocaleTimeString('en-GB', { hour12: false }),\n    'Tag UID': p.uid || '?',\n    Action: (p.action || 'tap').toUpperCase()\n});\nif (log.length > 15) log = log.slice(0, 15);\nflow.set('nfcLog', log);\nmsg.payload = log;\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 1600,
        "wires": [["tbl_nfc_history"]]
    },
