    {
        "id": "fn_chart_series",
        "type": "function",
        "z": "tab_bikestation",
        "name": "tag distance series",
        "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nvar slot = msg.topic.split('/')[2];\nmsg.topic = 'BK-00' + slot;\nmsg.payload = { distance_cm: p.distance_cm, timestamp: Date.now() };\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 1280,
        "wires": [["c_dist_history"]]
    },

