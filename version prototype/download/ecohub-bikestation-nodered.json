    {
        "id": "tmpl_header",
        "type": "ui-template",
        "z": "tab_bikestation",
        "group": "grp_header",
        "page": "ui_page_main",
        "ui": "ui_base_1",
        "name": "Station Header",
        "order": 1,
        "width": 12,
        "height": 1,
        "format": "<template>\n  <div class=\"ecohub-header\">\n    <div class=\"header-left\">\n      <div class=\"logo-wrap\"><span class=\"logo\">🚲</span></div>\n      <div class=\"title-wrap\">\n        <h1>EcoHub Central</h1>\n        <p class=\"subtitle\">Pi Square · Building A · Raspberry Pi 4B · 8GB</p>\n      </div>\n    </div>\n    <div class=\"header-right\">\n      <div class=\"status-pill\">\n        <span class=\"dot pulse\"></span>\n        <span class=\"status-text\">{{ status }}</span>\n      </div>\n      <div class=\"clock\">{{ time }}</div>\n      <div class=\"uptime\">UPTIME · {{ uptime }}</div>\n    </div>\n  </div>\n</template>\n<style>\n.ecohub-header {\n  display: flex; justify-content: space-between; align-items: center;\n  padding: 12px 20px;\n  background: linear-gradient(135deg, rgba(0,230,118,0.08), rgba(0,212,255,0.04));\n  border-radius: 12px; border: 1px solid #1f2429;\n}\n.header-left { display: flex; align-items: center; gap: 16px; }\n.logo-wrap {\n  width: 48px; height: 48px; border-radius: 12px;\n  background: linear-gradient(135deg, #00e676, #00d4ff);\n  display: flex; align-items: center; justify-content: center;\n  box-shadow: 0 0 24px rgba(0,230,118,0.3);\n}\n.logo { font-size: 26px; }\n.title-wrap h1 {\n  margin: 0; font-size: 22px; font-weight: 700; color: #e8eef0; letter-spacing: -0.02em;\n}\n.subtitle {\n  margin: 2px 0 0; font-size: 11px; color: #6b7680; font-family: monospace;\n  text-transform: uppercase; letter-spacing: 0.08em;\n}\n.header-right { display: flex; align-items: center; gap: 16px; }\n.status-pill {\n  display: flex; align-items: center; gap: 8px; padding: 6px 12px;\n  background: rgba(0,230,118,0.1); border: 1px solid rgba(0,230,118,0.3); border-radius: 999px;\n}\n.dot { width: 8px; height: 8px; background: #00e676; border-radius: 50%; }\n.pulse { animation: pdot 2s ease-in-out infinite; }\n@keyframes pdot { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.5; transform:scale(0.7); } }\n.status-text { font-size: 11px; font-weight: 600; color: #00e676; letter-spacing: 0.1em; }\n.clock {\n  font-family: monospace; font-size: 16px; font-weight: 600; color: #00d4ff;\n  background: rgba(0,212,255,0.05); padding: 8px 14px; border-radius: 8px;\n  border: 1px solid rgba(0,212,255,0.2);\n}\n.uptime {\n  font-family: monospace; font-size: 10px; color: #6b7680;\n  text-transform: uppercase; letter-spacing: 0.1em;\n}\n</style>\n<script>\nexport default {\n  data() { return { time: '', status: 'ONLINE', uptime: '4d 12h 36m' } },\n  mounted() {\n    const tick = () => {\n      this.time = new Date().toLocaleTimeString('en-GB', { hour12: false, timeZone: 'Europe/Amsterdam' })\n    }\n    tick()\n    setInterval(tick, 1000)\n  }\n}\n</script>",
        "storeOutMessages": true,
