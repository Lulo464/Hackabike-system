    {
        "id": "fn_rides_today",
        "type": "function",
        "z": "tab_bikestation",
        "name": "rides today counter",
        "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nif (p.action !== 'rent') return null;\n\nvar today = new Date().toDateString();\nvar counts = flow.get('ridesByDay') || {};\nif (counts.date !== today) { counts = { date: today, count: 0 }; }\ncounts.count = (counts.count || 0) + 1;\nflow.set('ridesByDay', counts);\n\nreturn { payload: counts.count + ' rides' };",
        "outputs": 1,
        "x": 360,
        "y": 820,
        "wires": [["t_kpi_rides"]]
    },
