    {
        "id": "fn_metrics",
        "type": "function",
        "z": "tab_bikestation",
        "name": "compute fleet KPIs",
        "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nvar slot = msg.topic.split('/')[2];\nvar state = flow.get('slotState') || {};\nstate[slot] = p.occupied;\nflow.set('slotState', state);\n\nvar occupied = Object.values(state).filter(v => v === true).length;\nvar available = Object.values(state).filter(v => v === false).length;\nvar total = Object.keys(state).length || 4;\n\nreturn [\n  { payload: available + ' / ' + total },\n  { payload: occupied + ' bike' + (occupied === 1 ? '' : 's') }\n];",
        "outputs": 2,
        "x": 340,
        "y": 720,
        "wires": [["t_kpi_available"], ["t_kpi_inuse"]]
    },
