    {
        "id": "fn_alerts",
        "type": "function",
        "z": "tab_bikestation",
        "name": "parse alert",
        "func": "let p; try { p = JSON.parse(msg.payload); } catch (e) { return null; }\nvar text = (p.type || 'MAINTENANCE').toUpperCase() + (p.slot ? ' · Slot ' + p.slot : '');\n\n// Track maintenance count\nvar maintCount = flow.get('maintCount') || 0;\nif ((p.type || '').toLowerCase() === 'maintenance') maintCount++;\nflow.set('maintCount', maintCount);\n\nreturn [\n  { payload: text },\n  { payload: '🚨 ' + text },\n  { payload: maintCount + ' alert' + (maintCount === 1 ? '' : 's') }\n];",
        "outputs": 3,
